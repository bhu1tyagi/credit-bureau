# =============================================================================
# CredBureau Environment Variables
# =============================================================================
# Copy this file to .env.local for local development.
# For production, store these in Vercel/System env config.

# --- NETWORK MODE ---
# 'testnet' (default in dev) or 'mainnet' (production)
NEXT_PUBLIC_NETWORK_MODE=testnet

# --- WALLET / RPC ---
NEXT_PUBLIC_ALCHEMY_API_KEY=
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=

# --- SUPABASE (required) ---
# Get from: supabase.com > project > settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- ON-CHAIN DATA: EVM (required) ---
# Get from: goldrush.dev > dashboard > API keys
GOLDRUSH_API_KEY=

# --- ATTESTATION (required) ---
# Private key of the wallet that signs EVM attestations (use a dedicated hot wallet)
EAS_ATTESTER_PRIVATE_KEY=

# --- SOLANA (required for Solana support) ---
# Get from: helius.dev > dashboard
HELIUS_API_KEY=
NEXT_PUBLIC_SOLANA_RPC_URL=
# Solana attester private key (base58 or JSON array). Falls back to EAS_ATTESTER_PRIVATE_KEY.
SOLANA_ATTESTER_PRIVATE_KEY=
# SAS program ID (default: 22zoJMtdu4tQc2PzL74ZUT7FrwgB1Udec8DdW4yw4BdG)
SAS_PROGRAM_ID=

# --- MAINNET RPCs (required for mainnet deployment) ---
BASE_MAINNET_RPC_URL=
ARBITRUM_MAINNET_RPC_URL=
OPTIMISM_MAINNET_RPC_URL=
ETHEREUM_MAINNET_RPC_URL=

# --- TESTNET RPCs (optional, defaults provided) ---
SEPOLIA_RPC_URL=
BASE_SEPOLIA_RPC_URL=
ARBITRUM_SEPOLIA_RPC_URL=
OPTIMISM_SEPOLIA_RPC_URL=

# --- BLOCK EXPLORER API KEYS (required for contract verification) ---
# Get from: basescan.org, arbiscan.io, etherscan.io
BASESCAN_API_KEY=
ARBISCAN_API_KEY=
OPTIMISTIC_ETHERSCAN_API_KEY=

# --- GAS SPONSORSHIP (optional) ---
# Coinbase Developer Platform paymaster for gasless txs on Base
# Get from: cdp.coinbase.com
NEXT_PUBLIC_CDP_PAYMASTER_URL=

# --- OFF-CHAIN DATA (optional) ---
# Cred Protocol baseline scores: app.credprotocol.com
CRED_PROTOCOL_API_KEY=
# Reclaim Protocol zkTLS: dev.reclaimprotocol.org
RECLAIM_APP_ID=
RECLAIM_APP_SECRET=

# --- ML SERVICE (optional) ---
# URL of the Python FastAPI ML service
ML_SERVICE_URL=http://localhost:8000

